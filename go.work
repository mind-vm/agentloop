// The chrome driver is a module of its own so that chromedp and the
// several hundred generated packages of cdproto stay off the dependency
// list of every agentloop deployment that never opens a browser. This
// workspace is what makes the split invisible during local development:
// `go build ./...` and `go test ./...` from the repo root see both
// modules and resolve browser/chrome's agentloop dependency against the
// working tree rather than a published tag.
go 1.26

use (
	.
	./browser/chrome
)
